# ---- painel-servicos: configuracao do servidor --------------------------------
# Copie para /etc/painel-servicos/env (modo 0600) na instalacao nativa via systemd,
# ou mantenha como .env na instalacao via docker compose.

# Porta HTTP do painel.
PANEL_PORT=8090

# Endereco de bind do servidor HTTP (0.0.0.0 para expor em todas as interfaces;
# 127.0.0.1 para acessar apenas localmente, ex.: atras de proxy reverso).
PANEL_BIND=0.0.0.0

# Socket unix do Docker (usado para listar containers e atribuir portas).
DOCKER_SOCKET=/var/run/docker.sock

# Usuario do HTTP Basic auth (usado so se PANEL_PASSWORD nao for vazio).
PANEL_USER=admin

# Senha do HTTP Basic auth. Vazio = sem autenticacao (AVISO no boot).
# Expor o painel sem senha publica lista de processos/portas/cmdlines do host.
PANEL_PASSWORD=

# Portas (separadas por virgula) cujos servicos sao tratados como https.
# Espacos e entradas invalidas sao ignorados.
PANEL_HTTPS_PORTS=443,8443,9443

# Intervalo (segundos) entre ciclos de sondagem HTTP em background.
PANEL_PROBE_INTERVAL=60

# Idade maxima (segundos) de um resultado de sondagem para ser considerado
# fresco. Se o cache passar dessa idade a porta e sondada de novo.
PANEL_PROBE_TTL=300

# Timeout (float, segundos) por requisicao de sondagem individual.
PANEL_PROBE_TIMEOUT=2.0

# Arquivo de cache em disco. Se vazio, o cache fica apenas em memoria e
# nao sobrevive a reinicio do servico.
PANEL_CACHE_FILE=
